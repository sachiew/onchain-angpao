{
  "name": "onchain-angpao",
  "scripts": {
    "anchor:build": "cd anchor && anchor build",
    "anchor:test": "cd anchor && anchor build && cargo test -- --test-threads=4",
    "build": "next build",
    "codama": "codama run js",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "program:deploy:devnet": "cd anchor && anchor deploy --provider.cluster devnet",
    "setup": "pnpm anchor:build && pnpm codama",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:create": "tsx scripts/smoke-create.ts",
    "smoke:claim": "tsx scripts/smoke-claim.ts",
    "relayer:new": "tsx scripts/relayer-new.ts",
    "relayer:fund": "tsx scripts/relayer-fund.ts",
    "smoke:gasless": "tsx scripts/smoke-gasless.ts"
  },
  "description": "Next.js, Tailwind, @solana/kit, Anchor vault program",
  "keywords": [
    "anchor",
    "kit",
    "nextjs",
    "react",
    "solana-kit",
    "tailwind",
    "typescript"
  ],
  "version": "0.0.0",
