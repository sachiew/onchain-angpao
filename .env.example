# ── Network ──────────────────────────────────────────────────────────────
# devnet (default) | localnet | mainnet. Mainnet ALSO needs NEXT_PUBLIC_ENABLE_MAINNET=true.
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_ENABLE_MAINNET=false
# Browser RPC. Public devnet works but is rate-limited; a free Helius/Triton key is better for demos.
NEXT_PUBLIC_RPC_URL=
# Optional websocket override (defaults to the RPC URL with ws://).
NEXT_PUBLIC_RPC_WS_URL=
# Server-side RPC for API routes (can contain a private key; never sent to the browser).
RPC_URL=

# ── Program ──────────────────────────────────────────────────────────────
# Your deployed program ID. Defaults to the ID in the IDL (anchor/target/idl/angpao.json).
NEXT_PUBLIC_PROGRAM_ID=

# ── Site ─────────────────────────────────────────────────────────────────
# Public URL, used for share links and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Prices (CoinGecko) ───────────────────────────────────────────────────
# A free Demo key is enough: https://www.coingecko.com/en/api. Pro takes precedence if both are set.
# With neither, the keyless public endpoint is used (fine for local dev only).
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=
# myr | sgd | idr | usd | cny
NEXT_PUBLIC_DEFAULT_FIAT=myr

# ── Gasless relayer (M4) ─────────────────────────────────────────────────
# Base58 or JSON-array secret key. Generate with `pnpm relayer:new`. Keep only a small SOL float.
RELAYER_SECRET_KEY=
RELAYER_DAILY_BUDGET_SOL=0.1
# Co-signs gated claims. May reuse the relayer key.
GATEKEEPER_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# Privy embedded wallets (email/Google). Without it, claimers get an in-browser burner wallet.
NEXT_PUBLIC_PRIVY_APP_ID=
# Rate limits + relayer budget. REQUIRED in production; in-memory fallback is dev-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
